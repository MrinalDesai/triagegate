# ── Bob Investigator dispatch configuration ───────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit a real .env file or a live API key.

# Required: Bob API key.  Passed to the child process environment only.
# Never placed in argv, logs, payload files, or responses.
BOB_API_KEY=

# Optional: path or name of the Bob CLI executable.
# Defaults to 'bob' (resolved via PATH).
# Windows users with an absolute path: BOB_CLI=C:\...\bob.cmd
BOB_CLI=bob

# Optional: maximum cost ceiling for a single investigation run.
# Must be a positive float; cannot exceed 3.0.
BOB_MAX_COST=3.0
